{
  "type": "object",
  "description": "Provenance sidecar. Each key is a JSON Pointer into the same document.",
  "propertyNames": {
    "pattern": "^/"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "confidence": {
        "type": "string",
        "x-vocab": "confidence"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*(?:--[a-z0-9]+(?:[-.][a-z0-9]+)*)*$",
          "description": "Source id."
        },
        "description": "Sources supporting this claim."
      },
      "derived_from": {
        "type": "string",
        "x-vocab": "derivation",
        "description": "How the value was arrived at, when not stated outright by a source."
      },
      "derivation_note": {
        "type": "string"
      },
      "note": {
        "type": "string"
      },
      "disputed": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "description": "One candidate value for the disputed field."
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*(?:--[a-z0-9]+(?:[-.][a-z0-9]+)*)*$",
                "description": "Source id."
              }
            },
            "confidence": {
              "type": "string",
              "x-vocab": "confidence"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "sources",
            "confidence"
          ]
        },
        "description": "Every credible candidate value, retained in full."
      },
      "adjudication": {
        "type": "string"
      },
      "adjudicated_by": {
        "type": "string"
      },
      "adjudicated_on": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "required": [
      "confidence"
    ]
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubecollection/schema/common/attestation.schema.json",
  "title": "Field-level provenance keyed by JSON Pointer"
}
