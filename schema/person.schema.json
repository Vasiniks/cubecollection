{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*(?:--[a-z0-9]+(?:[-.][a-z0-9]+)*)*$",
      "description": "Immutable identifier."
    },
    "entity": {
      "const": "person"
    },
    "name": {
      "type": "string"
    },
    "native_name": {
      "type": "string"
    },
    "role": {
      "type": "array",
      "items": {
        "type": "string",
        "x-vocab": "person-roles"
      }
    },
    "wca_id": {
      "type": "string",
      "pattern": "^[0-9]{4}[A-Z]{4}[0-9]{2}$"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "x-vocab": "record-status"
    },
    "attestations": {
      "$ref": "https://cubecollection/schema/common/attestation.schema.json"
    }
  },
  "required": [
    "id",
    "entity",
    "name",
    "status"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubecollection/schema/person.schema.json",
  "title": "A named individual"
}
