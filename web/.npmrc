# @react-three/fiber declares optional peers on the Expo / React Native stack
# (expo-gl, expo-asset, expo-file-system). npm tries to resolve them even though
# this is a web-only build, and the resolution fails against React 19.
#
# legacy-peer-deps keeps the install web-only: verified afterwards that no expo*
# or react-native* package is present in node_modules.
legacy-peer-deps=true
